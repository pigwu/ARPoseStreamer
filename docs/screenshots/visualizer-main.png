<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="600" fill="#1a1a1a"/>

  <!-- Grid background -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#333" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#grid)"/>

  <!-- 3D trajectory visualization -->
  <g>
    <!-- Trajectory path with gradient -->
    <defs>
      <linearGradient id="trajectoryGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" style="stop-color:#ff0000;stop-opacity:1" />
        <stop offset="50%" style="stop-color:#ffff00;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#00ffff;stop-opacity:1" />
      </linearGradient>
    </defs>

    <!-- Simulated 3D trajectory -->
    <path d="M 150,300 Q 250,200 350,250 T 550,300 Q 600,350 650,300"
          stroke="url(#trajectoryGradient)" stroke-width="4" fill="none" stroke-linecap="round"/>

    <!-- Coordinate axes -->
    <line x1="50" y1="550" x2="150" y2="550" stroke="#ff0000" stroke-width="2"/>
    <line x1="50" y1="550" x2="50" y2="450" stroke="#00ff00" stroke-width="2"/>
    <line x1="50" y1="550" x2="20" y2="520" stroke="#0000ff" stroke-width="2"/>

    <text x="155" y="555" fill="#ff0000" font-size="14" font-family="monospace">X</text>
    <text x="55" y="445" fill="#00ff00" font-size="14" font-family="monospace">Y</text>
    <text x="15" y="515" fill="#0000ff" font-size="14" font-family="monospace">Z</text>
  </g>

  <!-- Control panel -->
  <rect x="20" y="20" width="280" height="200" fill="#2a2a2a" rx="8"/>
  <text x="40" y="50" fill="#00d9ff" font-size="16" font-family="Arial" font-weight="bold">Connection Info</text>
  <text x="40" y="75" fill="#a0a0a0" font-size="12" font-family="monospace">Local IP: 192.168.1.100</text>
  <text x="40" y="95" fill="#a0a0a0" font-size="12" font-family="monospace">UDP Port: 5555</text>
  <text x="40" y="115" fill="#a0a0a0" font-size="12" font-family="monospace">Upload Port: 8000</text>

  <text x="40" y="145" fill="#00d9ff" font-size="14" font-family="Arial" font-weight="bold">Services</text>
  <rect x="40" y="155" width="15" height="15" fill="#00d9ff" rx="2"/>
  <text x="60" y="167" fill="#ffffff" font-size="12" font-family="Arial">Enable UDP Receiver</text>
  <rect x="40" y="180" width="15" height="15" fill="#00d9ff" rx="2"/>
  <text x="60" y="192" fill="#ffffff" font-size="12" font-family="Arial">Enable Upload Server</text>

  <!-- Stats panel -->
  <rect x="20" y="520" width="760" height="60" fill="#2a2a2a" rx="8"/>
  <text x="40" y="545" fill="#a0a0a0" font-size="12" font-family="monospace">FPS: 59.84</text>
  <text x="150" y="545" fill="#a0a0a0" font-size="12" font-family="monospace">Packets: 1284</text>
  <text x="280" y="545" fill="#a0a0a0" font-size="12" font-family="monospace">Dropped: 0</text>
  <text x="410" y="545" fill="#a0a0a0" font-size="12" font-family="monospace">Latency: 14.72ms</text>
  <text x="570" y="545" fill="#00d9ff" font-size="12" font-family="monospace">Uploads: 3</text>

  <text x="40" y="565" fill="#666" font-size="11" font-family="monospace">192.168.1.15:53318</text>

  <!-- Title -->
  <text x="400" y="590" fill="#666" font-size="14" font-family="Arial" text-anchor="middle">ARPose Visualizer - 3D Trajectory View</text>
</svg>
