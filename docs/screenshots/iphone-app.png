<svg width="400" height="800" xmlns="http://www.w3.org/2000/svg">
  <!-- iPhone frame -->
  <rect width="400" height="800" rx="40" fill="#000000"/>
  <rect x="10" y="10" width="380" height="780" rx="35" fill="#1a1a1a"/>

  <!-- Status bar -->
  <rect x="10" y="10" width="380" height="50" rx="35" fill="#000000"/>
  <text x="30" y="40" fill="#ffffff" font-size="14" font-family="Arial">9:41</text>
  <circle cx="350" cy="30" r="4" fill="#00ff00"/>
  <rect x="360" y="25" width="20" height="10" rx="2" stroke="#ffffff" stroke-width="1" fill="none"/>

  <!-- AR Camera view background -->
  <defs>
    <linearGradient id="arBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#2a4858;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a2838;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect x="10" y="60" width="380" height="680" fill="url(#arBg)"/>

  <!-- AR tracking indicator -->
  <circle cx="200" cy="100" r="3" fill="#00ff00"/>
  <text x="210" y="105" fill="#00ff00" font-size="12" font-family="monospace">AR Tracking Active</text>

  <!-- Coordinate overlay -->
  <rect x="20" y="120" width="360" height="120" fill="#000000" fill-opacity="0.7" rx="8"/>
  <text x="35" y="145" fill="#00d9ff" font-size="14" font-family="Arial" font-weight="bold">Position</text>
  <text x="35" y="170" fill="#ffffff" font-size="12" font-family="monospace">X: +0.0124 m</text>
  <text x="35" y="190" fill="#ffffff" font-size="12" font-family="monospace">Y: -0.0317 m</text>
  <text x="35" y="210" fill="#ffffff" font-size="12" font-family="monospace">Z: +0.8421 m</text>
  <text x="220" y="145" fill="#00d9ff" font-size="14" font-family="Arial" font-weight="bold">Orientation</text>
  <text x="220" y="170" fill="#ffffff" font-size="12" font-family="monospace">qx: +0.0021</text>
  <text x="220" y="190" fill="#ffffff" font-size="12" font-family="monospace">qy: -0.7063</text>
  <text x="220" y="210" fill="#ffffff" font-size="12" font-family="monospace">qz: +0.0064</text>

  <!-- 3D trajectory visualization -->
  <g>
    <defs>
      <linearGradient id="trajGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#ff0000;stop-opacity:0.8" />
        <stop offset="50%" style="stop-color:#ffff00;stop-opacity:0.8" />
        <stop offset="100%" style="stop-color:#00ffff;stop-opacity:0.8" />
      </linearGradient>
    </defs>
    <path d="M 100,400 Q 150,350 200,380 T 300,400 Q 320,450 280,480"
          stroke="url(#trajGrad)" stroke-width="3" fill="none" stroke-linecap="round"/>
  </g>

  <!-- Status info -->
  <rect x="20" y="520" width="360" height="80" fill="#000000" fill-opacity="0.7" rx="8"/>
  <text x="35" y="545" fill="#00d9ff" font-size="14" font-family="Arial" font-weight="bold">Streaming Status</text>
  <text x="35" y="570" fill="#00ff00" font-size="12" font-family="monospace">● Connected to 192.168.1.100</text>
  <text x="35" y="590" fill="#ffffff" font-size="12" font-family="monospace">FPS: 60 | Packets: 1284</text>

  <!-- Menu button -->
  <circle cx="50" cy="680" r="25" fill="#00d9ff" fill-opacity="0.3"/>
  <rect x="40" y="670" width="20" height="2" fill="#00d9ff"/>
  <rect x="40" y="678" width="20" height="2" fill="#00d9ff"/>
  <rect x="40" y="686" width="20" height="2" fill="#00d9ff"/>

  <!-- Record button -->
  <circle cx="200" cy="680" r="30" fill="#ff0000" fill-opacity="0.3"/>
  <circle cx="200" cy="680" r="20" fill="#ff0000"/>

  <!-- Settings button -->
  <circle cx="350" cy="680" r="25" fill="#00d9ff" fill-opacity="0.3"/>
  <circle cx="350" cy="680" r="8" fill="none" stroke="#00d9ff" stroke-width="2"/>
  <circle cx="350" cy="680" r="3" fill="#00d9ff"/>

  <!-- Home indicator -->
  <rect x="150" y="760" width="100" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.3"/>

  <!-- App title -->
  <text x="200" y="750" fill="#666" font-size="11" font-family="Arial" text-anchor="middle">ARPoseStreamer</text>
</svg>
